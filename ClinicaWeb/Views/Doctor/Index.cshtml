@* For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860 *@
@section Estilos {
    <link href="~/lib/datatables2/css/dataTables.dataTables.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <style>
        /* Estilos personalizados para esta vista */
        .page-header {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.5rem 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-left: 5px solid #0d6efd; /* Azul para doctores */
        }

            .page-header h2 {
                margin: 0;
                font-weight: 700;
                color: #1e293b;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .page-header i {
                color: #0d6efd;
            }

        /* Estilos para el modal */
        .modal-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); /* Degradado azul */
            color: white;
            border-bottom: none;
        }

            .modal-header .btn-close {
                filter: invert(1);
            }

            .modal-header.bg-warning {
                background: linear-gradient(135deg, #b45309 0%, #d97706 100%) !important;
                color: white !important;
            }

        .form-label {
            font-weight: 600;
            color: #475569;
            font-size: 0.9rem;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            padding: 0.6rem 1rem;
        }

            .form-control:focus, .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.25);
            }

        /* Tabla de reseñas */
        #tbResenas thead th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
        }

        .star-rating i {
            color: #f59e0b;
        }
    </style>
}

<!-- Encabezado de la Página -->
<div class="page-header">
    <h2><i class="fas fa-user-md"></i> Gestión de Doctores</h2>
    <span class="badge bg-primary fs-6 p-2"><i class="fas fa-hospital-user me-1"></i> Staff Médico</span>
</div>
<!-- ⚠️ NUEVO PANEL DE EMERGENCIAS -->
<div class="alert alert-danger alert-dismissible fade show d-none shadow-sm" id="panelEmergencias" role="alert">
    <h5 class="alert-heading fw-bold"><i class="fas fa-ambulance me-2"></i>¡Tienes Emergencias Pendientes!</h5>
    <div id="listaEmergencias" class="mt-2">
        <!-- Aquí el JS llenará los datos -->
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="card shadow-sm border-0" style="border-radius: 16px;">

            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 text-secondary fw-bold"><i class="fas fa-list me-2 text-primary"></i>Lista de Doctores</h5>
                    <button class="btn btn-primary" id="btnNuevo">
                        <i class="fas fa-plus me-1"></i> Nuevo Doctor
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="display" id="tbData" cellspacing="0" style="width:100%">
                        <tbody></tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- MODAL PARA CREAR/EDITAR DOCTOR -->
<div class="modal fade" id="mdData" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">

            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel"><i class="fas fa-user-edit me-2"></i>Datos del Doctor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Nro Documento</label>
                        <input type="text" class="form-control" id="txtNroDocumento" autocomplete="off" placeholder="Ej: 10000001">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Nombres</label>
                        <input type="text" class="form-control" id="txtNombres" autocomplete="off" placeholder="Nombres completos">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Apellidos</label>
                        <input type="text" class="form-control" id="txtApellidos" autocomplete="off" placeholder="Apellidos completos">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Género</label>
                        <select id="cboGenero" class="form-select" data-width="100%"></select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-12">
                        <label class="form-label">Especialidad</label>
                        <select id="cboEspecialidad" class="form-select" data-width="100%"></select>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-12">
                        <label class="form-label">URL de la Foto (Opcional)</label>
                        <input type="text" class="form-control" id="txtFotoUrl" autocomplete="off" placeholder="https://ejemplo.com/foto.jpg">
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardar">
                    <i class="fas fa-save me-1"></i> Guardar Doctor
                </button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL: VER RESEÑAS (ADMIN) -->
<div class="modal fade" id="mdResenasAdmin" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">

            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-star me-2"></i>Reseñas del Doctor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="tbResenas">
                        <thead>
                            <style>
                                /* ⚠️ Ajuste para que las estrellas no se rompan */
                                #tbResenas th:nth-child(2),
                                #tbResenas td:nth-child(2) {
                                    width: 120px; /* Ancho fijo para la columna de puntuación */
                                    min-width: 120px;
                                }
                            </style>
                            <tr>
                                <th>Paciente</th>
                                <th>Puntuación</th>
                                <th>Comentario</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div id="mensajeSinResenas" class="alert alert-info d-none text-center">
                    <i class="fas fa-info-circle me-2"></i> Este doctor aún no tiene reseñas.
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables2/js/moment.min.js"></script>
    <script src="~/lib/datatables2/js/dataTables.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/fontawesome/all.js"></script>
    <script src="~/js/Doctor.js"></script>
}