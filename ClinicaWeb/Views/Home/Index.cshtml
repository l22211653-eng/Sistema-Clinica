@{
    ViewData["Title"] = "Dashboard";
}

<!-- ⚠️ NOTA: Ya no necesitamos <html>, <head> ni <body> porque el Layout ya los tiene. -->
@section Estilos {
    <!-- Fuente Inter para un look moderno -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700&display=swap" rel="stylesheet">

    <style>
        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
            font-family: 'Inter', sans-serif;
        }

        /* Hero Section */
        .hero-card {
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            border-radius: 20px;
            padding: 3rem 2rem;
            color: white;
            text-align: center;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            position: relative;
            overflow: hidden;
        }

            .hero-card::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
                transform: rotate(45deg);
            }

        .hero-title {
            font-size: 2.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
        }

            .hero-title i {
                color: #38bdf8;
            }

        .hero-sub {
            font-size: 1.1rem;
            color: #94a3b8;
            position: relative;
            z-index: 1;
        }

        /* Tarjeta del Tecnológico */
        .tech-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 2rem;
            border-left: 6px solid #0b2f3f;
        }

        .tech-logo-box {
            background: #0b2f3f;
            padding: 2rem 3rem;
            border-radius: 15px;
            text-align: center;
            color: #f7d44a;
        }

            .tech-logo-box h3 {
                font-weight: 800;
                font-size: 1.5rem;
                margin: 0;
                letter-spacing: 1px;
            }

            .tech-logo-box h4 {
                font-weight: 800;
                font-size: 1.2rem;
                margin: 0.2rem 0 0 0;
                letter-spacing: 1px;
            }

        .tech-info {
            flex: 1;
            padding-left: 2rem;
        }

            .tech-info h5 {
                color: #1e293b;
                font-weight: 700;
                font-size: 1.3rem;
                margin-bottom: 0.5rem;
            }

            .tech-info p {
                color: #64748b;
                margin: 0;
                font-size: 1rem;
            }

        /* Secciones de Equipo y Docente */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .info-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 8px 25px rgba(0,0,0,0.05);
        }

        .info-card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f1f5f9;
        }

            .info-card-header i {
                background: #e0f2fe;
                color: #0284c7;
                padding: 10px;
                border-radius: 10px;
                font-size: 1.2rem;
            }

        .member-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .member-item {
            display: flex;
            align-items: center;
            gap: 15px;
            background: #f8fafc;
            padding: 1rem;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            transition: transform 0.2s ease;
        }

            .member-item:hover {
                transform: translateX(5px);
                border-color: #38bdf8;
            }

        .member-icon {
            width: 45px;
            height: 45px;
            background: #e0f2fe;
            color: #0284c7;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;

        }

        .member-details h6 {
            margin: 0;
            font-weight: 600;
            color: #1e293b;
        }

        .member-details small {
            color: #64748b;
        }

        /* Estilos específicos para el Docente */
        .teacher-card {
            border-left: 6px solid #f59e0b;
        }

            .teacher-card .info-card-header i {
                background: #fef3c7;
                color: #d97706;
            }

            .teacher-card .member-icon {
                background: #fef3c7;
                color: #d97706;
            }

        /* Responsividad */
        @@media (max-width: 768px) {
            .info-grid {
                grid-template-columns: 1fr;
            }

            .tech-card {
                flex-direction: column;
                text-align: center;
            }

            .tech-info {
                padding-left: 0;
                margin-top: 1.5rem;
            }
        }
    </style>
}

<div class="dashboard-container">

    <!-- 1. HERO SECTION -->
    <div class="hero-card">
        <div class="hero-title">
            <i class="fas fa-notes-medical"></i>
            Sistema de Gestión Médica
            <i class="fas fa-heartbeat"></i>
        </div>
        <div class="hero-sub">Plataforma integral para la administración clínica y hospitalaria</div>
    </div>

    <!-- 2. INSTITUCIÓN -->
    <div class="tech-card">
        <div class="tech-logo-box">
            <h3>TECNOLÓGICO</h3>
            <h4>NACIONAL DE MÉXICO</h4>
        </div>
        <div class="tech-info">
            <h5><i class="fas fa-university text-primary me-2"></i> Instituto Tecnológico</h5>
            <p>Excelencia educativa y formación profesional. Este sistema ha sido desarrollado como proyecto académico.</p>
        </div>
    </div>

    <!-- 3. EQUIPO Y DOCENTE (Grid) -->
    <div class="info-grid">

        <!-- Tarjeta del Equipo de Desarrollo -->
        <div class="info-card">
            <div class="info-card-header">
                <i class="fas fa-users"></i>
                Equipo de Desarrollo
            </div>
            <div class="member-list">
                <div class="member-item">
                    <div class="member-icon"><i class="fas fa-user-astronaut"></i></div>
                    <div class="member-details">
                        <h6>Novelo Astorga Kain Alejandro</h6>
                        <small>Matrícula: 22211623</small>
                    </div>
                </div>
                <div class="member-item">
                    <div class="member-icon"><i class="fas fa-user-graduate"></i></div>
                    <div class="member-details">
                        <h6>Espinoza Villa David Salvador</h6>
                        <small>Matrícula: 22211556</small>
                    </div>
                </div>
                <div class="member-item">
                    <div class="member-icon"><i class="fas fa-user-md"></i></div>
                    <div class="member-details">
                        <h6>Alberto Carlos Ruvalcaba Fernandez</h6>
                        <small>Matrícula: 22211653</small>
                    </div>

                </div>

            </div>
        </div>

        <!-- Tarjeta del Docente -->
        <div class="info-card teacher-card">
            <div class="info-card-header">
                <i class="fas fa-chalkboard-user"></i>
                Docente / Asesor
            </div>
            <div class="member-item">
                <div class="member-icon"><i class="fas fa-person-chalkboard"></i></div>
                <div class="member-details">
                    <h6>Miguel Angel Lopez Ramirez</h6>
                    <small>Profesor Titular</small>
                </div>
            </div>

            <div class="mt-4 p-3 rounded" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                <p class="mb-0 text-muted small">
                    <i class="fas fa-info-circle me-2"></i>
                    Sistema de gestión médica · Módulo administrativo y clínico | Versión 1.0
                </p>
            </div>
        </div>

    </div></div>