@* For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860 *@
@section Estilos {
    <link href="~/lib/datatables2/css/dataTables.dataTables.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/timepicker/1.3.5/jquery.timepicker.min.css">
    <link href="~/lib/jquery-ui/jquery-ui.css" rel="stylesheet" />

    <style>
        /* --- ESTILOS PERSONALIZADOS DOCTOR HORARIO --- */
        .page-header {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.5rem 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-left: 5px solid #8b5cf6;
        }

            .page-header h2 {
                margin: 0;
                font-weight: 700;
                color: #1e293b;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .page-header i {
                color: #8b5cf6;
            }

        .dia-seleccionado a {
            background-color: #8b5cf6 !important;
            color: white !important;
            border-radius: 50%;
            text-align: center;
        }

        .modal-header {
            background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 100%);
            color: white;
            border-bottom: none;
        }

        .dia-ocupado a {
            background-color: #e2e8f0 !important;
            color: #94a3b8 !important;
            text-decoration: line-through;
            cursor: not-allowed;
        }

        .modal-header .btn-close {
            filter: invert(1);
        }

        .alert-warning-custom {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 16px;
            color: #92400e;
        }

        .alert-danger-custom {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 16px;
            color: #991b1b;
        }

        .table-clean {
            background-color: transparent;
            margin-bottom: 0;
        }

            .table-clean thead th {
                border-bottom: 2px solid rgba(0,0,0,0.1);
                color: inherit;
                font-weight: 700;
            }

            .table-clean tbody td {
                border-bottom: 1px solid rgba(0,0,0,0.05);
                color: inherit;
            }
    </style>
}

<div class="page-header">
    <h2><i class="fas fa-calendar-alt"></i> Gestión de Horarios</h2>
    <span class="badge bg-primary fs-6 p-2"><i class="fas fa-clock me-1"></i> Disponibilidad Médica</span>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card shadow-sm border-0" style="border-radius: 16px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 text-secondary fw-bold"><i class="fas fa-list me-2 text-purple"></i>Horarios Registrados</h5>
                    <button class="btn btn-primary" id="btnNuevo" style="background-color: #8b5cf6; border-color: #8b5cf6;">
                        <i class="fas fa-plus me-1"></i> Nuevo Horario
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="display" id="tbData" cellspacing="0" style="width:100%">
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE NUEVO HORARIO -->
<div class="modal fade" id="mdData" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel"><i class="fas fa-clock me-2"></i>Registrar Horario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-12">
                        <label class="form-label fw-bold">Doctor</label>
                        <select id="cboDoctor" class="form-select" data-width="100%"></select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-12">
                        <label class="form-label fw-bold">Fechas de Atención</label>
                        <div id="calendarioFechas" class="d-flex justify-content-center"></div>
                        <input type="hidden" id="txtFechasSeleccionadas" />
                    </div>
                </div>

                <!-- ⚠️ TURNO MAÑANA -->
                <div class="bg-light p-3 rounded mb-3">
                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-sun text-warning me-2"></i>Turno Mañana (Opcional)</h6>
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <label class="form-label">Hora Inicio AM</label>
                            <input type="text" class="form-control" id="txtHoraInicioAM" autocomplete="off">
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label class="form-label">Hora Fin AM</label>
                            <input type="text" class="form-control" id="txtHoraFinAM" autocomplete="off">
                        </div>
                    </div>
                </div>

                <!-- ⚠️ TURNO TARDE -->
                <div class="bg-light p-3 rounded">
                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-moon text-primary me-2"></i>Turno Tarde (Opcional)</h6>
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <label class="form-label">Hora Inicio PM</label>
                            <input type="text" class="form-control" id="txtHoraInicioPM" autocomplete="off">
                        </div>
                        <div class="col-sm-6 mb-2">
                            <label class="form-label">Hora Fin PM</label>
                            <input type="text" class="form-control" id="txtHoraFinPM" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar" style="background-color: #8b5cf6; border-color: #8b5cf6;">Guardar Horario</button>
            </div>
        </div>
    </div>
</div>

<!-- SECCIÓN DE ALERTAS Y RENDIMIENTO -->
<div class="row mt-4">
    <div class="col-md-6 mb-4">
        <div class="alert alert-warning-custom h-100 p-4">
            <h5 class="fw-bold mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Doctores sin horarios (Próx. 30 días)</h5>
            <div class="table-responsive">
                <table class="table table-clean" id="tbAdvertencia">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Especialidad</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="alert alert-danger-custom h-100 p-4">
            <h5 class="fw-bold mb-3"><i class="fas fa-chart-line me-2"></i>Bajo rendimiento (Últimos 30 días)</h5>
            <div class="table-responsive">
                <table class="table table-clean" id="tbBajoRendimiento">
                    <thead>
                        <tr>
                            <th>Doctor</th>
                            <th>Especialidad</th>
                            <th class="text-center">Atendidas</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- SECCIÓN DE GRÁFICAS -->
<h4 class="mt-4 mb-3 fw-bold text-secondary">
    <i class="fas fa-chart-bar me-2 text-primary"></i>Rendimiento de Doctores - Últimos 30 días
</h4>
<div class="row" id="contenedorGraficas"></div>

@section Scripts {
    <script src="~/lib/datatables2/js/moment.min.js"></script>
    <script src="~/lib/datatables2/js/dataTables.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/timepicker/1.3.5/jquery.timepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.js"></script>
    <script src="~/lib/jquery-ui/datePicker/language/datepicker-es.js"></script>
    <script src="~/js/DoctorHorario.js"></script>
}