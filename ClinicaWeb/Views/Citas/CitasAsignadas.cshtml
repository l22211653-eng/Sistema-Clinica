@section Estilos {
    <link href="~/lib/datatables2/css/dataTables.dataTables.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}
<h2 class="mt-4 mb-4">Citas Asignadas</h2>

<div class="row">
    <div class="col-sm-12">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-chart-bar me-1"></i>
                Citas Asignadas
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-3">
                        <label class="col-form-label">Estado Cita:</label>
                        <select id="cboEstadoCita" class="form-select">
                            <option value="1">Pendiente</option>
                            <option value="2">Atendido</option>
                        </select>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-sm-12">
                        <table class="display" id="tbData" cellspacing="0" style="width:100%">
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- MODAL DE INDICACIONES Y RECETA -->
<div class="modal fade" id="mdData" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Hacemos el modal más grande -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Resumen Cita y Receta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <input type="hidden" id="txtIdCita" />

                <div class="row mb-3">
                    <div class="col-sm-12">
                        <label for="txtIndicaciones" class="form-label">Indicaciones Generales</label>
                        <textarea class="form-control" id="txtIndicaciones" rows="2"></textarea>
                    </div>
                </div>

                <hr />
                <h6><i class="fas fa-pills"></i> Receta Médica (Opcional)</h6>
                <div class="row mb-2">
                    <div class="col-sm-5">
                        <input type="text" class="form-control" id="txtMedicamento" placeholder="Medicamento (Ej: Paracetamol)">
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="txtDosis" placeholder="Dosis (Ej: 1 tableta cada 8h)">
                    </div>
                    <div class="col-sm-3">
                        <button type="button" class="btn btn-success w-100" id="btnAgregarMedicamento">Agregar</button>
                    </div>
                </div>

                <table class="table table-sm table-bordered mt-2" id="tbRecetaTemporal">
                    <thead>
                        <tr>
                            <th>Medicamento</th>
                            <th>Dosis</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <div class="alert alert-primary mt-2">
                    <p class="mb-0">
                        Después de ingresar las indicaciones y recetas,<br />
                        Presione "Terminar Cita" para marcar como ATENDIDO.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Volver</button>
                <button type="button" class="btn btn-primary" id="btnTerminarCita">Terminar Cita</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables2/js/moment.min.js"></script>
    <script src="~/lib/datatables2/js/dataTables.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/js/CitasAsignadas.js"></script> }