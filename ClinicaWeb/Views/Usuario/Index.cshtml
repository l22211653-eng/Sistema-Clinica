@* For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860 *@
@section Estilos {
    <link href="~/lib/datatables2/css/dataTables.dataTables.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <style>
        /* Estilos personalizados para esta vista */
        .page-header {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.5rem 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-left: 5px solid #6366f1; /* Color índigo para usuarios */
        }

            .page-header h2 {
                margin: 0;
                font-weight: 700;
                color: #1e293b;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .page-header i {
                color: #6366f1;
            }

        /* Estilos para el modal */
        .modal-header {
            background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%); /* Degradado índigo */
            color: white;
            border-bottom: none;
        }

            .modal-header .btn-close {
                filter: invert(1);
            }

        .form-label {
            font-weight: 600;
            color: #475569;
            font-size: 0.9rem;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            padding: 0.6rem 1rem;
        }

            .form-control:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.25);
            }
    </style>
}

<!-- Encabezado de la Página -->
<div class="page-header">
    <h2><i class="fas fa-users"></i> Gestión de Usuarios</h2>
    <span class="badge bg-primary fs-6 p-2"><i class="fas fa-shield-alt me-1"></i> Administrador</span>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card shadow-sm border-0" style="border-radius: 16px;">

            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 text-secondary fw-bold">Lista de Usuarios</h5>
                    <button class="btn btn-primary" id="btnNuevo">
                        <i class="fas fa-plus me-1"></i> Nuevo Usuario
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="display" id="tbData" cellspacing="0" style="width:100%">
                        <tbody></tbody>
                    </table>

                </div>


            </div>

        </div>
    </div>
</div>

<!-- MODAL DE CREAR/EDITAR USUARIO (Mejorado) -->
<div class="modal fade" id="mdData" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">

            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel"><i class="fas fa-user-edit me-2"></i>Datos del Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Nro Documento</label>
                        <input type="text" class="form-control" id="txtNroDocumento" autocomplete="off" placeholder="Ej: 12345678">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Nombres</label>
                        <input type="text" class="form-control" id="txtNombres" autocomplete="off" placeholder="Nombres completos">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Apellidos</label>
                        <input type="text" class="form-control" id="txtApellidos" autocomplete="off" placeholder="Apellidos completos">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Correo Electrónico</label>
                        <input type="email" class="form-control" id="txtCorreo" autocomplete="off" placeholder="correo@ejemplo.com">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                            <input type="password" class="form-control" id="txtClave" autocomplete="off" placeholder="••••••••">
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardar">
                    <i class="fas fa-save me-1"></i> Guardar Usuario
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables2/js/moment.min.js"></script>
    <script src="~/lib/datatables2/js/dataTables.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/sweetAlert2/js/sweetalert2.js"></script>
    <script src="~/js/Usuario.js"></script> }